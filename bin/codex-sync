#!/usr/bin/env bash
set -euo pipefail

diagnostic() {
	local color=$1 message=$2
	if [[ -t 2 && ! ${NO_COLOR+x} ]]; then
		printf '\033[%sm%s\033[0m\n' "$color" "$message" >&2
	else
		printf '%s\n' "$message" >&2
	fi
}
fail() {
	diagnostic 31 "❌ codex-sync: $*"
	exit 1
}
usage() {
	printf '%s\n' 'Usage: codex-sync <push|pull> [--dry-run] [--no-delete]' '       codex-sync --help | --version' '' 'Sync root: directory containing the nearest .codexignore in physical cwd or parents.' 'In that file, # codex-sync: no-global-ignore disables global ignore rules.'
}
no_global_directive() {
	local line=${1%$'\r'}
	line="${line#"${line%%[!$' \t']*}"}"
	line="${line%"${line##*[!$' \t']}"}"
	[[ $line == '# codex-sync: no-global-ignore' ]]
}
project_patterns() {
	local pattern
	while IFS= read -r pattern || [[ -n $pattern ]]; do
		if ! no_global_directive "$pattern"; then printf '%s\n' "$pattern"; fi
	done <"$project_ignore"
}
valid_name() { [[ $1 =~ ^[a-zA-Z0-9_-]([a-zA-Z0-9_.-]*[a-zA-Z0-9_-])?$ ]]; }
optional_file() {
	if [[ -e $1 || -L $1 ]]; then
		[[ -f $1 && -r $1 ]] || fail "Not a readable file: $1"
	fi
}

[[ $# -gt 0 ]] || {
	usage >&2
	exit 2
}
case $1 in
--help)
	usage
	exit 0
	;;
--version)
	printf 'codex-sync 0.1.0\n'
	exit 0
	;;
push | pull)
	direction=$1
	shift
	;;
*) fail "Expected push or pull (see --help)" ;;
esac
dry_run=false
delete=true
for arg in "$@"; do
	case $arg in
	--help)
		usage
		exit 0
		;;
	--version)
		printf 'codex-sync 0.1.0\n'
		exit 0
		;;
	--dry-run) dry_run=true ;;
	--no-delete) delete=false ;;
	--*) fail "Unknown option: $arg" ;;
	*) fail "Unexpected argument: $arg (run from the project directory)" ;;
	esac
done
config=${XDG_CONFIG_HOME:-$HOME/.config}/codex-sync
host=codex
optional_file "$config/target-host"
if [[ -f $config/target-host ]]; then host=$(cat -- "$config/target-host"); fi
[[ $host =~ ^([a-zA-Z0-9_][a-zA-Z0-9_.-]*@)?[a-zA-Z0-9_][a-zA-Z0-9_.-]*$ ]] || fail 'Invalid target-host: expected one SSH host name or alias'
local_dir=$(pwd -P) || fail 'Cannot resolve local project'
# Walk physical local parents only; an invalid nearest entry must not be skipped.
ignore_dir=$local_dir
project_ignore=''
while :; do
	candidate=${ignore_dir%/}/.codexignore
	if [[ -e $candidate || -L $candidate ]]; then
		project_ignore=$candidate
		break
	fi
	[[ $ignore_dir != / ]] || break
	ignore_dir=${ignore_dir%/*}
	[[ -n $ignore_dir ]] || ignore_dir=/
done
[[ -n $project_ignore && -f $project_ignore && -r $project_ignore ]] || fail "Required local project ignore file is missing or not a readable regular file: ${project_ignore:-$local_dir/.codexignore} (searched local project and parents; create it; an empty file is valid)"
local_dir=$ignore_dir
project=${local_dir##*/}
home_dir=$(cd -- "$HOME" && pwd -P) || fail 'Cannot resolve home directory'
[[ $local_dir != / && $local_dir != "$home_dir" ]] || fail 'Refusing to synchronize filesystem root or home directory'
valid_name "$project" || fail "Invalid project name: $project"
excludes=()
for pattern in '.git/' '.ssh/' '.codexignore'; do
	excludes+=("--exclude=$pattern")
done
no_global=false
while IFS= read -r pattern || [[ -n $pattern ]]; do
	if no_global_directive "$pattern"; then no_global=true; fi
done <"$project_ignore"
ignore_files=("$project_ignore")
if ! $no_global; then ignore_files=("$config/ignore" "${ignore_files[@]}"); fi
for ignore in "${ignore_files[@]}"; do
	optional_file "$ignore"
	if [[ -f $ignore ]]; then
		# rsync's list-clearing token would remove the mandatory exclusions.
		while IFS= read -r pattern || [[ -n $pattern ]]; do
			[[ $pattern != '!' && $pattern != $'!\r' ]] || fail "Ignore file cannot clear mandatory exclusions: $ignore"
		done <"$ignore"
		if $no_global && [[ $ignore == "$project_ignore" ]]; then
			excludes+=(--exclude-from=-)
		else
			excludes+=("--exclude-from=$ignore")
		fi
	fi
done
command -v ssh >/dev/null || fail 'OpenSSH client (ssh) is required'
command -v rsync >/dev/null || fail 'rsync is required'
# Project names contain no shell syntax. Reject remote symlinks resolving to / or HOME.
remote_check="p=\"\$HOME/$project\"; test -d \"\$p\" && r=\$(cd -- \"\$p\" && pwd -P) && h=\$(cd -- \"\$HOME\" && pwd -P) && test \"\$r\" != / && test \"\$r\" != \"\$h\""
# Only the validated project name expands locally; remote variables remain escaped.
# shellcheck disable=SC2029
ssh "$host" "$remote_check" || fail "Remote project missing, unsafe, or inaccessible: $host:~/$project"
local_path=$local_dir/
remote_path="$host:~/$project/"
if [[ $direction == push ]]; then
	source=$local_path
	destination=$remote_path
else
	source=$remote_path
	destination=$local_path
fi
options=(-av)
if $delete; then
	options+=(--delete)
	if ! $dry_run; then diagnostic 33 '⚠️ Sync will delete destination-only files.'; fi
fi
if $dry_run; then options+=(--dry-run); fi
printf 'ℹ️ %s: %s -> %s\n' "$direction" "$source" "$destination"
if $no_global; then
	project_patterns | rsync "${options[@]}" "${excludes[@]}" -- "$source" "$destination"
else
	rsync "${options[@]}" "${excludes[@]}" -- "$source" "$destination"
fi
