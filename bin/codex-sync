#!/usr/bin/env bash
# codex-sync
set -euo pipefail

readonly VERSION=1.2.0

diagnostic() {
	local color=$1 message=$2
	if [[ -t 2 && ! ${NO_COLOR+x} ]]; then
		printf '\033[%sm%s\033[0m\n' "$color" "$message" >&2
	else
		printf '%s\n' "$message" >&2
	fi
}
fail() {
	diagnostic 31 "❌ codex-sync: $*"
	exit 1
}
usage() {
	printf '%s\n' 'Usage: codex-sync <push|pull> [--dry-run] [--no-delete]' '       codex-sync inspect' '       codex-sync --help | --version' '' 'Sync root: directory containing the nearest .codexignore in physical cwd or parents.' 'Missing marker: interactive push/pull offers empty-file creation [y/N], then stops.' 'Git worktree root is an optional location hint; otherwise physical cwd is suggested.' 'Review sensitive files/exclusions and rerun; noninteractive commands never create it.' 'Missing remote destination: interactive push offers mkdir [y/N], then continues on success.' 'Pull never creates remote directories; dry-run reports missing destinations without creation.' 'In that file, # codex-sync: no-global-ignore disables global ignore rules.' 'inspect shows the sync root, source status and effective exclusion rules without SSH or rsync.'
}
assist_missing_ignore() {
	local suggested=$local_dir git_root='' answer='' physical_root
	# Git is only a hint for creation, never a synchronization-root resolver.
	if command -v git >/dev/null && git_root=$(git -C "$local_dir" rev-parse --show-toplevel 2>/dev/null); then
		if physical_root=$(cd -- "$git_root" 2>/dev/null && pwd -P); then
			case $local_dir/ in
			"${physical_root%/}/"*) suggested=$physical_root ;;
			esac
		fi
	fi
	local marker=${suggested%/}/.codexignore
	diagnostic 33 "⚠️ No .codexignore found (searched local project and parents). Suggested location: $marker"
	diagnostic 33 '⚠️ Review sensitive files and exclusions before syncing; an empty file does not protect secrets.'
	[[ -t 0 && -t 2 ]] || fail 'Noninteractive context: create and review .codexignore manually, then rerun.'
	local physical_home
	physical_home=$(cd -- "$HOME" && pwd -P) || fail 'Cannot resolve home directory'
	[[ $suggested != / && $suggested != "$physical_home" ]] || fail 'Refusing to synchronize filesystem root or home directory'
	valid_name "${suggested##*/}" || fail "Invalid project name: ${suggested##*/}"
	printf '⚠️ Create empty .codexignore at %s? [y/N] ' "$marker" >&2
	if ! IFS= read -r answer; then answer=''; fi
	case $answer in
	y | Y | yes | YES | Yes)
		# Atomic exclusive creation: refuse existing files, directories and symlinks.
		if ! (
			set -o noclobber
			: >"$marker"
		) 2>/dev/null; then
			fail "Cannot create .codexignore without overwriting an existing entry: $marker"
		fi
		diagnostic 33 "⚠️ Created empty $marker. Review sensitive files and exclusions, then rerun. No synchronization performed."
		;;
	*) diagnostic 33 '⚠️ Creation declined. Create and review .codexignore, then rerun. No synchronization performed.' ;;
	esac
	exit 1
}
no_global_directive() {
	local line=${1%$'\r'}
	line="${line#"${line%%[!$' \t']*}"}"
	line="${line%"${line##*[!$' \t']}"}"
	[[ $line == '# codex-sync: no-global-ignore' ]]
}
project_patterns() {
	local pattern
	while IFS= read -r pattern || [[ -n $pattern ]]; do
		if [[ $1 != "$project_ignore" ]] || ! no_global_directive "$pattern"; then printf '%s\n' "$pattern"; fi
	done <"$1"
}
display_path() {
	local home=${HOME%/}
	if [[ $1 == "$HOME" || $1 == "$home" ]]; then
		printf '~'
	elif [[ $1 == "$home/"* ]]; then
		printf '%s/%s' '~' "${1#"$home/"}"
	else
		printf '%s' "$1"
	fi
}
display_sorted_patterns() {
	# Sort only report rows, using a deterministic bytewise A-Z order.
	local LC_ALL=C pattern i
	local -a rows=()
	while IFS= read -r pattern; do
		i=${#rows[@]}
		while ((i > 0)) && [[ ${rows[i - 1]} > $pattern ]]; do
			rows[i]=${rows[i - 1]}
			i=$((i - 1))
		done
		rows[i]=$pattern
	done
	for pattern in "${rows[@]}"; do printf '  %s\n' "$pattern"; done
}
display_patterns() {
	local pattern
	while IFS= read -r pattern; do
		# rsync exclude-from files ignore empty lines and leading # or ; comments.
		case $pattern in
		'' | $'\r' | \#* | \;*) continue ;;
		esac
		printf '%s\n' "$pattern"
	done < <(project_patterns "$1") | display_sorted_patterns
}
valid_name() { [[ $1 =~ ^[a-zA-Z0-9_-]([a-zA-Z0-9_.-]*[a-zA-Z0-9_-])?$ ]]; }
optional_file() {
	if [[ -e $1 || -L $1 ]]; then
		[[ -f $1 && -r $1 ]] || fail "Not a readable file: $1"
	fi
}

[[ $# -gt 0 ]] || {
	usage >&2
	exit 2
}
case $1 in
--help)
	usage
	exit 0
	;;
--version)
	printf 'codex-sync %s\n' "$VERSION"
	exit 0
	;;
push | pull | inspect)
	command=$1
	shift
	;;
*) fail "Expected push, pull or inspect (see --help)" ;;
esac
dry_run=false
delete=true
for arg in "$@"; do
	case $arg in
	--help)
		usage
		exit 0
		;;
	--version)
		printf 'codex-sync %s\n' "$VERSION"
		exit 0
		;;
	--dry-run)
		[[ $command != inspect ]] || fail "Unsupported option for inspect: $arg"
		dry_run=true
		;;
	--no-delete)
		[[ $command != inspect ]] || fail "Unsupported option for inspect: $arg"
		delete=false
		;;
	--*) fail "Unknown option: $arg" ;;
	*) fail "Unexpected argument: $arg (run from the project directory)" ;;
	esac
done
config=${XDG_CONFIG_HOME:-$HOME/.config}/codex-sync
local_dir=$(pwd -P) || fail 'Cannot resolve local project'
# Walk physical local parents only; an invalid nearest entry must not be skipped.
ignore_dir=$local_dir
project_ignore=''
while :; do
	candidate=${ignore_dir%/}/.codexignore
	if [[ -e $candidate || -L $candidate ]]; then
		project_ignore=$candidate
		break
	fi
	[[ $ignore_dir != / ]] || break
	ignore_dir=${ignore_dir%/*}
	[[ -n $ignore_dir ]] || ignore_dir=/
done
if [[ -z $project_ignore && $command != inspect ]]; then assist_missing_ignore; fi
[[ -n $project_ignore && -f $project_ignore && -r $project_ignore ]] || fail "Required local project ignore file is missing or not a readable regular file: ${project_ignore:-$local_dir/.codexignore} (searched local project and parents; create it; an empty file is valid)"
local_dir=$ignore_dir
project=${local_dir##*/}
home_dir=$(cd -- "$HOME" && pwd -P) || fail 'Cannot resolve home directory'
[[ $local_dir != / && $local_dir != "$home_dir" ]] || fail 'Refusing to synchronize filesystem root or home directory'
valid_name "$project" || fail "Invalid project name: $project"
excludes=()
builtin_patterns=('.git/' '.ssh/' '.codexignore')
for pattern in "${builtin_patterns[@]}"; do
	excludes+=("--exclude=$pattern")
done
no_global=false
while IFS= read -r pattern || [[ -n $pattern ]]; do
	if no_global_directive "$pattern"; then no_global=true; fi
done <"$project_ignore"
ignore_files=("$project_ignore")
if ! $no_global; then ignore_files=("$config/ignore" "${ignore_files[@]}"); fi
for ignore in "${ignore_files[@]}"; do
	optional_file "$ignore"
	if [[ -f $ignore ]]; then
		# rsync's list-clearing token would remove the mandatory exclusions.
		while IFS= read -r pattern || [[ -n $pattern ]]; do
			[[ $pattern != '!' && $pattern != $'!\r' ]] || fail "Ignore file cannot clear mandatory exclusions: $ignore"
		done <"$ignore"
		if $no_global; then
			excludes+=(--exclude-from=-)
		else
			excludes+=("--exclude-from=$ignore")
		fi
	fi
done
# Validation and source selection above are shared with both transfer directions.
if [[ $command == inspect ]]; then
	bold='' reset='' red=''
	if [[ -t 1 && ! ${NO_COLOR+x} ]]; then
		bold=$'\033[1m' reset=$'\033[0m' red=$'\033[31m'
	fi
	printf '%sSync root:%s %s\n%sBuilt-in:%s\n' "$bold" "$reset" "$(display_path "$local_dir")" "$bold" "$reset"
	printf '%s\n' "${builtin_patterns[@]}" | display_sorted_patterns
	printf '%sGlobal:%s %s' "$bold" "$reset" "$(display_path "$config/ignore")"
	if $no_global; then
		printf ' %s[disabled]%s' "$red" "$reset"
	fi
	printf '\n'
	if ! $no_global && [[ -f $config/ignore ]]; then display_patterns "$config/ignore"; fi
	printf '%sLocal:%s %s\n' "$bold" "$reset" "$(display_path "$project_ignore")"
	display_patterns "$project_ignore"
	exit 0
fi
host=codex
optional_file "$config/target-host"
if [[ -f $config/target-host ]]; then host=$(cat -- "$config/target-host"); fi
[[ $host =~ ^([a-zA-Z0-9_][a-zA-Z0-9_.-]*@)?[a-zA-Z0-9_][a-zA-Z0-9_.-]*$ ]] || fail 'Invalid target-host: expected one SSH host name or alias'
command -v ssh >/dev/null || fail 'OpenSSH client (ssh) is required'
command -v rsync >/dev/null || fail 'rsync is required'
# Only the validated project name expands locally; remote variables stay escaped.
# Exit 3 means an absent entry; files, dangling symlinks and unsafe aliases fail.
remote_check="p=\"\$HOME/$project\"; if test ! -e \"\$p\" && test ! -L \"\$p\"; then exit 3; fi; test -d \"\$p\" && r=\$(cd -- \"\$p\" && pwd -P) && h=\$(cd -- \"\$HOME\" && pwd -P) && test \"\$r\" != / && test \"\$r\" != \"\$h\""
remote_status=0
# shellcheck disable=SC2029
ssh "$host" "$remote_check" || remote_status=$?
if ((remote_status != 0)); then
	if ((remote_status != 3)); then
		fail "Remote project unsafe, inaccessible, or SSH check failed: $host:~/$project"
	fi
	[[ $command == push ]] || fail "Remote project missing: $host:~/$project (pull never creates directories)"
	! $dry_run || fail "Remote destination missing: $host:~/$project (dry-run never creates directories)"
	[[ -t 0 && -t 2 ]] || fail "Remote destination missing: $host:~/$project (noninteractive context; create it manually)"
	printf '⚠️ Create remote destination directory %s:~/%s? [y/N] ' "$host" "$project" >&2
	answer=''
	if ! IFS= read -r answer; then answer=''; fi
	case $answer in
	y | Y | yes | YES | Yes) ;;
	*) fail 'Remote directory creation declined. No synchronization performed.' ;;
	esac
	# No -p: fail if any entry appeared after validation; never overwrite it.
	# shellcheck disable=SC2029
	ssh "$host" "mkdir -- \"\$HOME/$project\"" || fail "Cannot create remote destination: $host:~/$project"
	# Recheck directory safety after successful creation before any transfer.
	# shellcheck disable=SC2029
	ssh "$host" "$remote_check" || fail "Created remote destination failed validation: $host:~/$project"
fi
local_path=$local_dir/
remote_path="$host:~/$project/"
if [[ $command == push ]]; then
	source=$local_path
	destination=$remote_path
else
	source=$remote_path
	destination=$local_path
fi
options=(-av)
if $delete; then
	options+=(--delete)
	if ! $dry_run; then diagnostic 33 '⚠️ Sync will delete destination-only files.'; fi
fi
if $dry_run; then options+=(--dry-run); fi
printf 'ℹ️ %s: %s -> %s\n' "$command" "$source" "$destination"
if $no_global; then
	project_patterns "$project_ignore" | rsync "${options[@]}" "${excludes[@]}" -- "$source" "$destination"
else
	rsync "${options[@]}" "${excludes[@]}" -- "$source" "$destination"
fi
